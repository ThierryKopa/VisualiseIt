@page "/"
@inject NavigationManager NavManager

<PageTitle>Visualise IT!</PageTitle>

<div class="hero-container">
    <div class="hero-grid">
        <div class="hero-left">
            <div class="hero-left-top">
                <nav class="lang-switcher">
                    <a href="/Culture/Set?culture=de&redirectUri=@Uri.EscapeDataString(NavManager.Uri)">DE</a>
                    <span aria-hidden="true">|</span>
                    <a href="/Culture/Set?culture=en&redirectUri=@Uri.EscapeDataString(NavManager.Uri)">EN</a>
                </nav>
            </div>
            <div class="hero-left-content">
                <h1 class="hero-title">Visualise IT!</h1>
                <p class="hero-subtitle">@Loc["FillerText"]</p>
                <a href="/login" class="btn-start">@Loc["GetS"] →</a>
            </div>
        </div>

        <div class="hero-right">
            <img src="images/VisualiseItHome.png" alt="Mathematische Formeln" class="hero-image" />
        </div>
    </div>
</div>

@inject IStringLocalizer<Registrieren> Loc

@code {
    


}

<style>
    .hero-container {
        min-height: 100vh;
        background-color: #e0e0e0;
        display: flex;
        flex-direction: column;
    }

    .lang-switcher {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .lang-switcher {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.95rem;
        margin-bottom: 2rem;
        width: fit-content;
        align-self: flex-end; /* прижимает к правому краю hero-left */
        margin-left: auto; /* дублируем на случай если align-self не сработает */
    }

        .lang-switcher a {
            text-decoration: none !important; /* !important перебивает глобальные стили */
            color: #222 !important;
            font-weight: 400 !important;
        }

        .lang-switcher span {
            color: #555;
        }

        .lang-switcher a.active {
            text-decoration: underline !important;
            font-weight: 600 !important;
        }

    .hero-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 100vh;
    }

    .hero-left {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 3rem 4rem 3rem;
        background-color: #e0e0e0;
    }

    .hero-left-top {
        display: flex;
        justify-content: flex-end; /* прижимает nav вправо */
        margin-bottom: auto;
    }

    .hero-left-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
    }

    .hero-title {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: clamp(3.5rem, 8vw, 6rem);
        font-weight: 350;
        line-height: 1.1;
        color: #111;
        margin: 0 0 2rem 0;
    }

    .hero-subtitle {
        font-size: 1rem;
        color: #333;
        margin: 0 0 3rem 0;
    }

    .btn-start {
        display: inline-block;
        padding: 0.85rem 2.5rem;
        background-color: transparent;
        border: 1.5px solid #333;
        color: #111;
        font-size: 1rem;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease;
        align-self: flex-start;
    }

        .btn-start:hover {
            background-color: #333;
            color: #fff;
        }

    .hero-right {
        overflow: hidden;
    }

    .hero-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    @@media (max-width: 768px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }

        .hero-right {
            height: 40vh;
            order: -1;
        }

        .hero-left {
            padding: 2rem 1.5rem;
        }

        .hero-title {
            font-size: 3rem;
        }
    }
</style>