<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Components\Modules\" />
		<Folder Include="Database\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Components\Pages\Simulation.en.resx">
			<Generator></Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Models\Ball.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Ball.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Models\Ball.en.resx">
			<Generator></Generator>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Models\Ball.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Ball.resx</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>